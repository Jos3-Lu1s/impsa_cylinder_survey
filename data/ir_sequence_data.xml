<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_impsa_cylinder_survey" model="ir.sequence">
            <field name="name">Secuencia Levantamiento Cilindros</field>
            <field name="code">impsa.cylinder.survey</field>
            <field name="prefix">LEV-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

         <record id="seq_impsa_apu_survey" model="ir.sequence">
            <field name="name">Secuencia APU</field>
            <field name="code">impsa.apu.survey</field>
            <field name="prefix">APU-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        
        <record id="seq_code_partner" model="ir.sequence">
            <field name="name">Código Contacto</field>
            <field name="code">res.partner.code</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_impsa_apu_survey_actions" model="ir.sequence">
           <field name="name">Secuencia Acciones</field>
           <field name="code">impsa.apu.survey.actions</field>
           <field name="prefix">ACT-</field>
           <field name="padding">5</field>
           <field name="company_id" eval="False"/>
       </record>
        <record id="seq_impsa_apu_survey_margins" model="ir.sequence">
           <field name="name">Secuencia Acciones</field>
           <field name="code">impsa.apu.survey.margins</field>
           <field name="prefix">MARG-</field>
           <field name="padding">5</field>
           <field name="company_id" eval="False"/>
       </record>
    </data>
</odoo>