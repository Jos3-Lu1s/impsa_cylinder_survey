<odoo>
    <data noupdate="1">
        <!--  DEPARTAMENTOS  -->
        <record id="dep_area_comercial" model="hr.department">
            <field name="name">Área Comercial</field>
        </record>
        <record id="dep_area_operativa" model="hr.department">
            <field name="name">Área Operativa</field>
        </record>
        <record id="dep_aprobadores" model="hr.department">
            <field name="name">Aprobadores</field>
        </record>

        <!--  USUARIOS DE PRUEBA  -->
        <record id="user_gerente_produccion" model="res.users">
            <field name="name">Gerente de Producción</field>
            <field name="login">gerente.produccion@impsa.com</field>
            <field name="email">gerente.produccion@impsa.com</field>
            <field name="password">123</field>
        </record>
        <record id="user_coordinador_compras" model="res.users">
            <field name="name">Coordinador de Compras</field>
            <field name="login">coordinador.compras@impsa.com</field>
            <field name="email">coordinador.compras@impsa.com</field>
            <field name="password">123</field>
        </record>
        <record id="user_gerente_operativo" model="res.users">
            <field name="name">Gerente Operativo</field>
            <field name="login">gerente.operativo@impsa.com</field>
            <field name="email">gerente.operativo@impsa.com</field>
            <field name="password">123</field>
        </record>
        <record id="user_director" model="res.users">
            <field name="name">Director</field>
            <field name="login">director@impsa.com</field>
            <field name="email">director@impsa.com</field>
            <field name="password">123</field>
        </record>
        <record id="user_programador" model="res.users">
            <field name="name">Programador</field>
            <field name="login">programador@impsa.com</field>
            <field name="email">programador@impsa.com</field>
            <field name="password">123</field>
        </record>
        <record id="user_automatizacion" model="res.users">
            <field name="name">Automatización</field>
            <field name="login">automatizacion@impsa.com</field>
            <field name="email">automatizacion@impsa.com</field>
            <field name="password">123</field>
        </record>

        <!--  EMPLEADOS Y DEPARTAMENTOS  -->
        <record id="emp_gerente_produccion" model="hr.employee">
            <field name="name">Gerente de Producción</field>
            <field name="user_id" ref="user_gerente_produccion"/>
            <field name="department_id" ref="dep_aprobadores"/>
        </record>
        <record id="emp_coordinador_compras" model="hr.employee">
            <field name="name">Coordinador de Compras</field>
            <field name="user_id" ref="user_coordinador_compras"/>
            <field name="department_id" ref="dep_aprobadores"/>
        </record>
        <record id="emp_gerente_operativo" model="hr.employee">
            <field name="name">Gerente Operativo</field>
            <field name="user_id" ref="user_gerente_operativo"/>
            <field name="department_id" ref="dep_aprobadores"/>
        </record>
        <record id="emp_director" model="hr.employee">
            <field name="name">Director</field>
            <field name="user_id" ref="user_director"/>
            <field name="department_id" ref="dep_aprobadores"/>
        </record>
        <record id="emp_programador" model="hr.employee">
            <field name="name">Programador</field>
            <field name="user_id" ref="user_programador"/>
            <field name="department_id" ref="dep_area_operativa"/>
        </record>
        <record id="emp_automatizacion" model="hr.employee">
            <field name="name">Automatización</field>
            <field name="user_id" ref="user_automatizacion"/>
            <field name="department_id" ref="dep_area_comercial"/>
        </record>
    </data>
</odoo>