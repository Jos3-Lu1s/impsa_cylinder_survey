<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="approval_cat_po_impsa" model="approval.category">
            <field name="name">Aprobaciones IMPSA</field>
            <field name="description">Categoría para validar solicitudes y aprobaciones de compras y levantamientos.</field>
            <field name="has_amount">required</field>
            <field name="has_partner">required</field>
            <field name="has_product">required</field>
            <field name="has_quantity">required</field>
            <field name="has_date">no</field>
            <field name="has_period">no</field>
            <field name="has_reference">no</field>
            <field name="has_location">no</field>
            <!-- Los aprobadores NO van aquí: los asigna el código de la orden de compra -->
            <field name="approver_sequence" eval="True"/>
            <field name="approval_minimum">1</field>
        </record>


    </data>
</odoo>