<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_impsa_cotizacion" model="report.paperformat">
            <field name="name">Cotización IMPSA</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">28</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_spacing">25</field>
            <field name="header_line" eval="False"/>
            <field name="dpi">90</field>
        </record>

        <!-- Asocia el paperformat a tu reporte -->
        <record id="action_report_proforma_custom" model="ir.actions.report">
            <field name="paperformat_id" ref="paperformat_impsa_cotizacion"/>
        </record>
    </data>
</odoo>