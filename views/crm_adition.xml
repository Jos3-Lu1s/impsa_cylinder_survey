<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_adition" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.cylinder_survey</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="test_label"/>
                <field name="selection_crm" widget="radio" options="{'horizontal': True}" optional="show"/>
            </xpath>
    
                <xpath expr="//notebook" position="inside">
                    <page string="Taller de Cilindros" name="cylinder_survey_page">
                        <group>
                            <field name="test_label"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>