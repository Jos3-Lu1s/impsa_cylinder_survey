<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="crm.stage_lead2" model="crm.stage">
            <field name="name">Levantamiento</field> 
        </record>

        <record id="view_crm_adition" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.cylinder_survey</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor" />
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_cylinder_surveys"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="cylinder_survey_count == 0">

                        <field name="cylinder_survey_count" widget="statinfo"
                            string="Levantamientos" />
                    </button>

                    <button name="action_view_apus"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="apu_survey_count == 0">

                        <field name="apu_survey_count" widget="statinfo" string="APU" />
                    </button>
                </xpath>

                <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="is_won_stage" invisible="1" />
                    <!-- <field name="selection_crm"  readonly="stage_sequence > 2" /> -->
                    <field name="selection_type"  readonly="stage_sequence > 2 or cylinder_survey_count >= 1 or apu_survey_count >= 1" widget="radio" options="{'horizontal': True}"/>
                </xpath>

                <xpath expr="//header//button[@name='action_sale_quotations_new']"
                    position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_open_cylinder_survey"
                        string="Levantamiento"
                        type="object"
                        class="oe_highlight"
                        invisible="stage_sequence &lt; 2 or selection_type == 'manufacturing' or cylinder_survey_count >= 1 or selection_type == False" />
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_open_apu"
                        string="APU"
                        type="object"
                        class="oe_highlight"
                        invisible="stage_sequence &lt; 2 or selection_type == 'repair' or apu_survey_count >= 1 or selection_type == False" />
                </xpath>

            </field>
        </record>

        <record id="crm_lead_partner_required_inherit" model="ir.ui.view">
            <field name="name">crm.lead.partner.required.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
            <field name="arch" type="xml">
            
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">not is_partner_visible</attribute>
                    <attribute name="required">is_partner_visible</attribute>
                </xpath>
            
            </field>
        </record>

        <record id="quick_create_opportunity_form_inherit_selection" model="ir.ui.view">
            <field name="name">crm.lead.quick.create.inherit.selection</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[div/field[@name='expected_revenue']]" position="after">
                    <div class="d-flex align-items-center" colspan="2">
                        <i class="fa fa-check-circle-o" title="selection_type"/>
                        <div class="d-flex">
                            <field name="selection_type" class="m-0" widget="radio" options="{'horizontal': True}"/><span class="fw-bolder text-danger">*</span>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="crm_case_kanban_view_leads_inherit_selection" model="ir.ui.view">
            <field name="name">crm.lead.kanban.inherit.selection</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='activity_ids']" position="after">
                    
                    <div t-if="record.selection_type.raw_value" class="text-muted small">
                        <i class="fa fa-circle-o fa-fw me-1" title="Tipo de Selección"/>
                        <field name="selection_type"/>
                    </div>
                    
                </xpath>
                
            </field>
        </record>

        <record id="view_crm_case_opportunities_filter_inherit_cylinder" model="ir.ui.view">
            <field name="name">crm.lead.search.inherit.cylinder.type</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="selection_type"/>
                </xpath>

                <xpath expr="//filter[@name='assigned_to_me']" position="after">
                    <separator/>
                    <filter string="Fabricación" 
                            name="filter_type_manufacturing" 
                            domain="[('selection_type', '=', 'manufacturing')]"/>
                    <filter string="Reparación" 
                            name="filter_type_repair" 
                            domain="[('selection_type', '=', 'repair')]"/>
                    <separator/>
                </xpath>

                <xpath expr="//filter[@name='stage']" position="after">
                    <filter string="Tipo de Cilindro" 
                            name="groupby_selection_type" 
                            context="{'group_by':'selection_type'}"/>
                </xpath>
                
            </field>
        </record>
    </data>
</odoo>