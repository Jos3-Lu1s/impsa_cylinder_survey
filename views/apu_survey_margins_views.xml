<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_impsa_apu_survey_margins_tree"
            model="ir.ui.view">
        <field name="name">impsa.apu.survey.margins.tree</field>
        <field name="model">impsa.apu.survey.margins</field>
        <field name="arch"
               type="xml">
            <list string="Márgenes de Costos" editable="bottom"
                decoration-info="type_cost_margin == 'material' and type_profit_margin == 'indirect_cost'"
                decoration-warning="type_cost_margin == 'material' and type_profit_margin == 'profit_margin'"
                decoration-success="type_cost_margin == 'labour' and type_profit_margin == 'indirect_cost'"
                decoration-danger="type_cost_margin == 'labour' and type_profit_margin == 'profit_margin'">
                <field name="margin_code"/>
                <field name="type_cost_margin" widget="selection_badge"/>
                <field name="type_profit_margin" widget="selection_badge"/>
                <field name="percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_impsa_apu_survey_margins_search" model="ir.ui.view">
        <field name="name">impsa.apu.survey.margins.search</field>
        <field name="model">impsa.apu.survey.margins</field>
        <field name="arch" type="xml">
            <search string="Buscar Márgenes">
                <field name="margin_code"/>
                <field name="type_cost_margin"/>
                <field name="type_profit_margin"/>
                <filter string="Material" name="material" domain="[('type_cost_margin', '=', 'material')]"/>
                <filter string="Mano de Obra" name="labour" domain="[('type_cost_margin', '=', 'labour')]"/>
                <separator/>
                <filter string="Costo Indirecto" name="indirect" domain="[('type_profit_margin', '=', 'indirect_cost')]"/>
                <filter string="Utilidad" name="profit" domain="[('type_profit_margin', '=', 'profit_margin')]"/>
                <group>
                    <filter string="Margen de Costos" name="group_by_cost" context="{'group_by': 'type_cost_margin'}"/>
                    <filter string="Tipo" name="group_by_type" context="{'group_by': 'type_profit_margin'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apu_survey_margins_all" model="ir.actions.act_window">
        <field name="name">Márgenes de Costos</field>
        <field name="res_model">impsa.apu.survey.margins</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define tu primer Margen de Costo
            </p>
            <p>
                Configura los porcentajes de costos indirectos y utilidad tanto para 
                materiales como para mano de obra. Estos valores se aplican por defecto 
                en los nuevos Análisis de Precios Unitarios.
            </p>
        </field>
    </record>
</odoo>