<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_impsa_cylinder_options_search" model="ir.ui.view">
        <field name="name">impsa.cylinder.options.search</field>
        <field name="model">impsa.cylinder.options</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipos de Cilindros">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Archivados" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_impsa_cylinder_options_list" model="ir.ui.view">
        <field name="name">impsa.cylinder.options.list</field>
        <field name="model">impsa.cylinder.options</field>
        <field name="arch" type="xml">
            <list string="Catálogo de Valores" editable="bottom" decoration-muted="not active">
                <field name="name" decoration-bf="1" placeholder="Ej. Doble Efecto" width="300px"/>
                <field name="code" decoration-info="1" placeholder="Ej. CE-DE" width="150px"/>
                <field name="active" widget="boolean_toggle" width="80px"/>
            </list>
        </field>
    </record>

    <record id="action_impsa_cylinder_options" model="ir.actions.act_window">
        <field name="name">Opciones de Cilindros</field>
        <field name="res_model">impsa.cylinder.options</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_impsa_cylinder_options_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Opción de Cilindro
            </p>
            <p>
                Precaución: El 'Código Técnico' (Ej. CE-T para Telescópico) está ligado 
                a la lógica del sistema (ocultar/mostrar campos). Modifícalo con cuidado.
            </p>
        </field>
    </record>
</odoo>