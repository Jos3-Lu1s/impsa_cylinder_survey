<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_impsa_apu_survey_tree"
            model="ir.ui.view">
        <field name="name">impsa.apu.survey.tree</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch"
               type="xml">
            <list string="Levantamientos"
                  decoration-muted="state == 'cancel'">
                <field name="name"
                       decoration-bf="1" />
                <field name="survey_id"
                       decoration-bf="1" />
                <field name="group_id"
                       decoration-bf="1" />
                <field name="gran_subtotal_lm"
                       decoration-bf="1" />
                <field name="gran_total_lm"
                       decoration-bf="1" />
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancel'"
                       decoration-bf="1" />
                <field name="date"  options="{'numeric': true}" readonly="1"/>
                <field name="partner_id"
                       widget="many2one_avatar" />
                <field name="activity_ids"
                       string="Actividades"
                       widget="list_activity" />
            </list>
        </field>
    </record>
    <record id="view_impsa_apu_survey_form"
            model="ir.ui.view">
        <field name="name">impsa.apu.survey.form</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch"
               type="xml">
            <form string="APU">
                <header>
                    <button name="action_to_confirmed"
                            string="Confirmar APU"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'" />
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state not in ['confirmed']"
                            confirm="¿Está seguro de que desea cancelar este registro?" />
                    <button name="action_set_draft"
                            string="Establece a Borrador"
                            type="object"
                            invisible="state != 'cancel'" />
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,cancel" />
                </header>
                <sheet>
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    
                        <div class="oe_title mb-0 w-100">
                            <label for="name" class="oe_edit_only" string="Referencia"/>
                            <h1>
                                <field name="name" class="oe_inline text-truncate w-100"/>
                            </h1>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 text-end w-100" style="max-width: 600px; margin-left: auto;">
                            
                            <div class="flex-fill rounded-3 border border-2 border-info bg-info bg-opacity-25 p-3 d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <label for="gran_subtotal_lm" class="fs-5 fw-bold text-muted mb-0" string="Subtotal" />
                                    <i class="fa fa-usd fs-4 text-info" aria-hidden="true" title="Subtotal" />
                                </div>
                                <field name="gran_subtotal_lm" class="fw-bolder h3 mb-0 w-100" />
                            </div>

                            <div class="flex-fill rounded-3 border border-2 border-primary bg-primary bg-opacity-25 p-3 d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <label for="gran_total_lm" class="fs-5 fw-bold text-muted mb-0" string="Total" />
                                    <i class="fa fa-money fs-4 text-primary" aria-hidden="true" title="Total" />
                                </div>
                                <field name="gran_total_lm" class="fw-bolder h2 text-primary mb-0 w-100" />
                            </div>

                        </div>
                        
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_survey" type="object" class="oe_stat_button" icon="fa-gears" invisible="not survey_id">
                            <field name="cylinder_survey_count" widget="statinfo" string="Levantamiento"/>
                        </button>
                        <button name="action_view_quote"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not quote_ids">
                            <field name="quote_count"
                                   widget="statinfo"
                                   string="Cotización" />
                        </button>
                        <button name="action_view_lead"
                                type="object"
                                class="oe_stat_button d-flex align-items-center gap-2"
                                icon="fa-handshake-o"
                                invisible="lead_count == 0">
                            <field name="lead_count" widget="statinfo" string="Oportunidad"/>
                        </button>
                    </div> 
                    <group col="2"
                           name="Formulario de APU">
                        <group name="Información General"
                               string="Información General">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="cylinder_qty_by_group" readonly="survey_id == True or state != 'draft'"/>
                            <field name="quote_ids"
                                   invisible="True" />
                            <field name="tipo_costo_mo" readonly="state != 'draft'"/>
                            <field name="costo_fijo_lm"
                                   invisible="tipo_costo_mo != 'costo_fijo_mo'" readonly="state != 'draft'"/>
                            <field name="apu_product_id" readonly="state != 'draft'"/>
                        </group>
                        <group name="Datos de Entrada de Cotizador"
                               class="border-2 border-start">
                            <separator class="fw-bolder fs-6"
                                       string="Márgen de costos de material" />
                            <field name="porcentaje_cindirectos_material"
                                   widget="percentage" readonly="state != 'draft'"/>
                            <field name="porcentaje_utaimp_material"
                                   widget="percentage" readonly="state != 'draft'"/>
                            <separator class="fw-bolder fs-6"
                                       string="Márgen de costos de MO" />
                            <field name="porcentaje_cindirectos_mo"
                                   widget="percentage" readonly="state != 'draft'"/>
                            <field name="porcentaje_utaimp_mo"
                                   widget="percentage" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <separator class="fw-bolder fs-5 mt-4 mb-3" string="Resumen de Costos" />

                        <div class="row g-4 mb-4">
                            
                            <div class="col-12 col-md-6">
                                <div class="border rounded-3 p-3 h-100 shadow-sm">
                                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                                        <div class="border rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                            <i class="fa fa-cubes fs-4" aria-hidden="true" title="Materiales"></i>
                                        </div>
                                        <h4 class="mb-0 fw-bold text-dark m-0">Costos de Material</h4>
                                    </div>
                                    
                                    <group class="mt-0">
                                        <field name="subtotal_material_lm" string="Subtotal" />
                                        <field name="costos_indirectos_material_lm" string="Costos Indirectos" />
                                        <field name="utilidad_impuestos_material_lm" string="Utilidad (A.I.)" />
                                        <field name="total_material_lm" string="Total" class="oe_subtotal_footer_separator fw-bolder fs-5 text-dark" />
                                    </group>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="border rounded-3 p-3 h-100 shadow-sm">
                                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                                        <div class="border rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                            <i class="fa fa-male fs-3" aria-hidden="true" style="padding-bottom: 2px;" title="Mano de Obra"></i>
                                        </div>
                                        <h4 class="mb-0 fw-bold text-dark m-0">Costos de M.O.</h4>
                                    </div>
                                    
                                    <group class="mt-0">
                                        <field name="subtotal_mo_lm" string="Subtotal" />
                                        <field name="costos_indirectos_mo_lm" string="Costos Indirectos" />
                                        <field name="utilidad_impuestos_mo_lm" string="Utilidad (A.I.)" />
                                        <field name="total_mo_lm" string="Total" class="oe_subtotal_footer_separator fw-bolder fs-5 text-dark" />
                                    </group>
                                </div>
                            </div>
                        </div>
                    <notebook>
                        <page string="Cotizador de Materiales"
                              name="impsa_tab">
                            <field name="lm_ids" readonly="state != 'draft'">
                                <list editable="bottom"
                                      create="1"
                                      edit="1"
                                      delete="1">
                                    <field name="product_id" />
                                    <field name="reference" />
                                    <field name="cantidad_lm" />
                                    <field name="unidad_lm" />
                                    <field name="precio_unitario_lm" />
                                    <field name="importe_material_lm" />
                                    <field name="mo_hrs_lm"
                                           widget="float_time" />
                                    <field name="empleado_mo_lm"
                                           column_invisible="parent.tipo_costo_mo != 'costo_empleado_mo'" />
                                    <field name="importe_mo_lm" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </chatter>
            </form>
        </field>
    </record>
</odoo>