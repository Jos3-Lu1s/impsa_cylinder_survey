<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_impsa_apu_survey_tree"
            model="ir.ui.view">
        <field name="name">impsa.apu.survey.tree</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch"
               type="xml">
            <list string="Levantamientos"
                  decoration-muted="state == 'cancel'" create="0">
                <field name="name"
                       decoration-bf="1" />
                <field name="survey_id"
                       decoration-bf="1" />
                <field name="group_id"
                       decoration-bf="1" />
                <field name="gran_subtotal_lm"
                       decoration-bf="1" />
                <field name="gran_total_lm"
                       decoration-bf="1" />
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancel'"
                       decoration-bf="1" />
                <field name="date"
                       options="{'numeric': true}"
                       readonly="1" />
                <field name="partner_id"
                       widget="many2one_avatar" />
                <field name="activity_ids"
                       string="Actividades"
                       widget="list_activity" />
            </list>
        </field>
    </record>
    <record id="view_impsa_apu_survey_form"
            model="ir.ui.view">
        <field name="name">impsa.apu.survey.form</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch"
               type="xml">
            <form string="APU" create="0">
                <header>
                    <button name="action_to_confirmed"
                            string="Confirmar APU"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'" />
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state not in ['confirmed']"
                            confirm="¿Está seguro de que desea cancelar este registro?" />
                    <button name="action_set_draft"
                            string="Establece a Borrador"
                            type="object"
                            invisible="state != 'cancel'" />
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,cancel" />
                </header>
                <sheet>
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                        <div class="oe_title mb-0 w-100">
                            <label for="name"
                                   class="oe_edit_only"
                                   string="Referencia" />
                            <h1>
                                <field name="name"
                                       class="oe_inline text-truncate w-100" />
                            </h1>
                        </div>
                        <div class="d-flex flex-column flex-sm-row gap-3 text-end w-100"
                             style="max-width: 600px; margin-left: auto;">
                            <div class="flex-fill rounded-3 border border-2 border-info bg-info bg-opacity-25 p-3 d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <label for="gran_subtotal_lm"
                                           class="fs-5 fw-bold text-muted mb-0"
                                           string="Subtotal" />
                                    <i class="fa fa-usd fs-4 text-info"
                                       aria-hidden="true" />
                                </div>
                                <field name="gran_subtotal_lm"
                                       class="fw-bolder h3 mb-0 w-100" />
                            </div>
                            <div class="flex-fill rounded-3 border border-2 border-primary bg-primary bg-opacity-25 p-3 d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <label for="gran_total_lm"
                                           class="fs-5 fw-bold text-muted mb-0"
                                           string="Total" />
                                    <i class="fa fa-money fs-4 text-primary"
                                       aria-hidden="true" />
                                </div>
                                <field name="gran_total_lm"
                                       class="fw-bolder h2 text-primary mb-0 w-100" />
                            </div>
                        </div>
                    </div>
                    <div class="oe_button_box"
                         name="button_box">
                        <button name="action_view_survey"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-gears"
                                invisible="not survey_id"
                                groups="impsa_cylinder_survey.group_cylinder_survey_user">
                            <field name="cylinder_survey_count"
                                   widget="statinfo"
                                   string="Levantamiento" />
                        </button>
                        <button name="action_view_quote"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-usd"
                                invisible="not quote_ids"
                                groups="sales_team.group_sale_salesman">
                            <field name="quote_count"
                                   widget="statinfo"
                                   string="Cotización" />
                        </button>
                        <button name="action_view_lead"
                                type="object"
                                class="oe_stat_button d-flex align-items-center gap-2"
                                icon="fa-handshake-o"
                                invisible="lead_count == 0"
                                groups="sales_team.group_sale_salesman">
                            <field name="lead_count"
                                   widget="statinfo"
                                   string="Oportunidad" />
                        </button>
                    </div>
                    <group col="2"
                           name="Formulario de APU">
                        <group name="Información General"
                               string="Información General">
                            <field name="partner_id"
                                   readonly="state != 'draft'" />
                            <field name="partner_email" widget="email" string="" colspan="2" invisible="not partner_email"/>
                            <field name="cylinder_qty_by_group"
                                   readonly="survey_id or state != 'draft'" />
                            <field name="quote_ids"
                                   invisible="True" />
                            <field name="tipo_costo_mo"
                                   readonly="state != 'draft'" invisible="True"/>
                            <field name="costo_fijo_lm"
                                   invisible="tipo_costo_mo != 'costo_fijo_mo'"
                                   readonly="state != 'draft'" />
                            <field name="apu_product_id"
                                   readonly="state != 'draft'" />
                            <field name="is_financed" readonly="state != 'draft'"/>
                        </group>
                        <group name="Datos de Entrada de Cotizador"
                               class="border-2 border-start">
                            <separator class="fw-bolder fs-6"
                                       string="Márgen de costos de material" />
                            <field name="porcentaje_cindirectos_material"                           
                                   readonly="state != 'draft'"
                                   options="{'no_open': True,'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" />
                            <field name="porcentaje_utaimp_material"
                                   readonly="state != 'draft'"
                                   options="{'no_open': True,'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" />
                            <separator class="fw-bolder fs-6"
                                       string="Márgen de costos de MO" />
                            <field name="porcentaje_cindirectos_mo"
                                   readonly="state != 'draft'"
                                   options="{'no_open': True,'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" />
                            <field name="porcentaje_utaimp_mo"
                                   readonly="state != 'draft'"
                                   options="{'no_open': True,'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" />
                            <separator class="fw-bolder fs-6"
                                       string="Financiamientos"
                                       invisible="is_financed == False" />
                            <field name="porcentaje_gran_subtotal"
                                   string="Porcentaje (%)"
                                   readonly="state != 'draft'"
                                   widget="percentage"
                                   invisible="is_financed == False" />
                            <field name="importe_porcentaje_gran_subtotal"
                                   string="Importe Calculado"
                                   readonly="1"
                                   invisible="is_financed == False" />
                            <field name="subtotal_fin"
                                   string="Subtotal Financiado"
                                   readonly="1"
                                   invisible="is_financed == False" />
                        </group>
                    </group>
                    <separator class="fw-bolder fs-5 mt-4 mb-3"
                               string="Resumen de Costos" />
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100 shadow-sm">
                                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                                    <div class="border rounded-circle d-flex align-items-center justify-content-center me-3"
                                         style="width: 50px; height: 50px;">
                                        <i class="fa fa-cubes fs-4" aria-hidden="true" title="Materiales" />
                                    </div>
                                    <h4 class="mb-0 fw-bold text-dark m-0">Costos de Material</h4>
                                </div>
                                <group class="mt-0">
                                    <field name="subtotal_material_lm"
                                           string="Subtotal" />
                                    <field name="costos_indirectos_material_lm"
                                           string="Costos Indirectos" />
                                    <field name="utilidad_impuestos_material_lm"
                                           string="Utilidad (A.I.)" />
                                    <field name="total_material_lm"
                                           string="Total"
                                           class="oe_subtotal_footer_separator fw-bolder fs-5 text-dark" />
                                </group>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100 shadow-sm">
                                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                                    <div class="border rounded-circle d-flex align-items-center justify-content-center me-3"
                                         style="width: 50px; height: 50px;">
                                        <i class="fa fa-male fs-3" aria-hidden="true" style="padding-bottom: 2px;" title="Mano de Obra" />
                                    </div>
                                    <h4 class="mb-0 fw-bold text-dark m-0">Costos de M.O.</h4>
                                </div>
                                <group class="mt-0">
                                    <field name="subtotal_mo_lm"
                                           string="Subtotal" />
                                    <field name="costos_indirectos_mo_lm"
                                           string="Costos Indirectos" />
                                    <field name="utilidad_impuestos_mo_lm"
                                           string="Utilidad (A.I.)" />
                                    <field name="total_mo_lm"
                                           string="Total"
                                           class="oe_subtotal_footer_separator fw-bolder fs-5 text-dark" />
                                </group>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Cotizador de Materiales"
                              name="impsa_tab">
                            <field name="lm_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom"
                                      create="1"
                                      edit="1"
                                      delete="1">
                                    <field name="action_id" />
                                    <field name="obs" optional="show" />
                                    <field name="product_id" />
                                    <field name="cantidad_lm" />
                                    <field name="unidad_lm" />
                                    <field name="precio_unitario_lm" />
                                    <field name="importe_material_lm" />
                                    <field name="mo_hrs_lm"
                                           widget="float_time" />
                                    <field name="empleado_mo_lm" />
                                    <field name="importe_mo_lm" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </chatter>
            </form>
        </field>
    </record>
    
    <record id="view_impsa_apu_survey_kanban" model="ir.ui.view">
        <field name="name">impsa.apu.survey.kanban</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" create="false" records_draggable="false" sample="1">
                <field name="state" />
                <field name="cylinder_qty_by_group" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <field class="fs-5 fw-bolder text-dark text-truncate me-2" name="name"/>
                                <div class="flex-shrink-0">
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'draft'"
                                           decoration-success="state == 'confirmed'"
                                           decoration-danger="state == 'cancel'"/>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted d-flex align-items-center mb-1 text-truncate" title="Cliente">
                                    <i class="fa fa-building-o me-2 text-primary" title="Cliente"/>
                                    <field name="partner_id" class="text-truncate"/>
                                </div>
                                <div class="text-muted d-flex align-items-center mb-1 text-truncate" title="Cantidad de Cilindros">
                                    <i class="fa fa-cubes me-2 text-primary" title="Cantidad de Cilindros"/>
                                    <field name="cylinder_qty_by_group"/>
                                    <span class="ms-1">
                                          <t t-if="record.cylinder_qty_by_group.raw_value == 1">Cilindro</t>
                                          <t t-else="">Cilindros</t>
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <div class="d-flex align-items-center">
                                    <field name="activity_ids" widget="kanban_activity" class="me-2"/>
                                   <span class="text-muted small">
                                        <span class="text-muted small d-inline-flex align-items-center">
                                            <i class="fa fa-calendar-o me-1" title="Fecha"></i>
                                            <field name="date" widget="date" options="{'numeric': true}"/>
                                        </span>
                                    </span>
                                </div>
                                <div class="fw-bolder text-dark fs-5">
                                    <i class="fa fa-dollar me-1 text-muted" title="Total"/>
                                    <field name="gran_total_lm" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_impsa_apu_survey_pivot" model="ir.ui.view">
        <field name="name">impsa.apu.survey.pivot</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de APU" sample="1">
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="gran_subtotal_lm" type="measure"/>
                <field name="gran_total_lm" type="measure"/>
                <field name="costo_fijo_lm" invisible="1"/>
                <field name="importe_porcentaje_gran_subtotal" invisible="1"/>
                <field name="porcentaje_gran_subtotal" invisible="1"/>
                <field name="subtotal_fin" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_impsa_apu_survey_graph" model="ir.ui.view">
        <field name="name">impsa.apu.survey.graph</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch" type="xml">
            <graph string="Análisis de APU" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="gran_total_lm" type="measure"/>
                <field name="costo_fijo_lm" invisible="1"/>
                <field name="importe_porcentaje_gran_subtotal" invisible="1"/>
                <field name="porcentaje_gran_subtotal" invisible="1"/>
                <field name="subtotal_fin" invisible="1"/>
            </graph>
        </field>
    </record>

    <record id="view_impsa_apu_survey_search" model="ir.ui.view">
        <field name="name">impsa.apu.survey.search</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch" type="xml">
            <search string="Buscar APU">
                <field name="name" string="Referencia" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id" operator="child_of"/>
                <field name="survey_id"/>
                <field name="group_id"/>
                <field name="apu_product_id"/>
                <separator/>
                <filter string="Mis APUs" name="my_apu" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Para Cotizar" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelado" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Fecha" name="date" date="date"/>
                <group>
                    <filter string="Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Creado por" name="group_by_creator" context="{'group_by': 'create_uid'}"/>
                    <filter string="Levantamiento" name="group_by_survey" context="{'group_by': 'survey_id'}"/>
                    <filter string="Producto/Cilindro" name="group_by_product" context="{'group_by': 'apu_product_id'}"/>
                    <filter string="Fecha" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_impsa_apu_survey_calendar" model="ir.ui.view">
        <field name="name">impsa.apu.survey.calendar</field>
        <field name="model">impsa.apu.survey</field>
        <field name="arch" type="xml">
            <calendar string="APUs" date_start="date" color="state" hide_time="true" event_limit="5" create="0">
                <field name="partner_id" avatar_field="avatar_128"/>
                <field name="gran_total_lm" widget="monetary"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="action_apu_survey_all"
            model="ir.actions.act_window">
        <field name="name">Análisis de Precios Unitarios</field>
        <field name="res_model">impsa.apu.survey</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer Análisis de Precios Unitarios (APU)
            </p>
        </field>
    </record>

    <record id="action_apu_survey_actions_all"
            model="ir.actions.act_window">
        <field name="name">Acciones de los Cilindros</field>
        <field name="res_model">impsa.apu.survey.actions</field>
        <field name="view_mode">list</field>
    </record>

    <!-- <record id="action_apu_survey_margins_all"
            model="ir.actions.act_window">
            <field name="name">Margenes de Costos</field>
            <field name="res_model">impsa.apu.survey.margins</field>
            <field name="view_mode">list</field>
       </record> -->
       <record id="action_apu_survey_margins_passw" model="ir.actions.act_window">
              <field name="name">Catálogo de Márgenes</field>
              <field name="res_model">impsa.apu.survey.passw</field>
              <field name="view_mode">form</field>
              <field name="target">new</field> 
       </record>
</odoo>