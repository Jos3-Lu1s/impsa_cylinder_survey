<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="action_impsa_cylinder_survey_all" model="ir.actions.act_window">
      <field name="name">Todos los Registros</field>
      <field name="res_model">impsa.cylinder.survey</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
                    Crear nuevo levantamiento (F-05-01)
        </p>
        <p>Aquí verás el histórico completo del taller.</p>
      </field>
    </record>

    <record id="action_impsa_cylinder_survey_draft" model="ir.actions.act_window">
      <field name="name">Levantamientos Pendientes</field>
      <field name="res_model">impsa.cylinder.survey</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('state', '=', 'draft')]</field>
      <field name="context">{'hide_state': True}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
                    No hay levantamientos pendientes. ¡Buen trabajo!
        </p>
      </field>
    </record>

    <record id="action_impsa_cylinder_survey_quoted" model="ir.actions.act_window">
      <field name="name">Cotizaciones Activas</field>
      <field name="res_model">impsa.cylinder.survey</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('state', '=', 'quoted')]</field>
      <field name="context">{'hide_state': True}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
                    No hay cotizaciones en este momento.
        </p>
        <p>Las órdenes aparecerán aquí cuando se genere una cotización.</p>
      </field>
    </record>

    <record id="action_impsa_cylinder_survey_confirmed" model="ir.actions.act_window">
      <field name="name">Órdenes de Trabajo Activas</field>
      <field name="res_model">impsa.cylinder.survey</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('state', '=', 'confirmed')]</field>
      <field name="context">{'hide_state': True}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
                    No hay órdenes de trabajo activas en este momento.
        </p>
        <p>Las órdenes aparecerán aquí cuando confirmes un levantamiento.</p>
      </field>
    </record>

    <record id="action_cylinder_options" model="ir.actions.act_window">
      <field name="name">Catálogo de cilindros</field>
      <field name="res_model">impsa.cylinder.options</field>
      <field name="view_mode">list,form</field>
    </record>

    <record id="action_cylinder_material" model="ir.actions.act_window">
      <field name="name">Catálogo de materiales</field>
      <field name="res_model">impsa.cylinder.material</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_crm_cylinder_survey_root" name="Taller de Cilindros" parent="crm.crm_menu_root" sequence="15"/>

    <menuitem id="menu_cylinder_survey_all" name="Todos los Registros" parent="menu_crm_cylinder_survey_root" action="action_impsa_cylinder_survey_all" sequence="10"/>

    <menuitem id="menu_cylinder_survey_draft" name="Levantamientos" parent="menu_crm_cylinder_survey_root" action="action_impsa_cylinder_survey_draft" sequence="20"/>

    <menuitem id="menu_cylinder_survey_quoted" name="APUS" parent="menu_crm_cylinder_survey_root" action="action_impsa_cylinder_survey_quoted" sequence="30"/>

    <menuitem id="menu_cylinder_survey_confirmed" name="Órdenes de Trabajo" parent="menu_crm_cylinder_survey_root" action="action_impsa_cylinder_survey_confirmed" sequence="40"/>

    <menuitem id="menu_cylinder_catalogos" name="Catálogos" parent="menu_crm_cylinder_survey_root" sequence="50"/>
    
    <menuitem id="menu_cylinder_options" name="Catálogo de cilindros" parent="menu_cylinder_catalogos" action="action_cylinder_options" sequence="50"/>

    <menuitem id="menu_cylinder_material" name="Catálogo de materiales" parent="menu_cylinder_catalogos" action="action_cylinder_material" sequence="60"/>

  </data>
</odoo>