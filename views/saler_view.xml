<odoo>
    <data>
        <record id="view_sale_form_inherit_survey" model="ir.ui.view">
            <field name="name">sale.form.inherit.survey</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']"
                   position="after">       
                     <field name="survey_id"
                     />
                     <field name="apu_id"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_apu_survey"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="apu_survey_count == 0">
                        <field name="apu_survey_count" widget="statinfo" string="APU"/>
                        </button>

                </xpath>
            </field>
        </record>
    </data>
</odoo>