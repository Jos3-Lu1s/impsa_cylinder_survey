<odoo>
    <data>
        <record id="view_sale_form_inherit_survey" model="ir.ui.view">
            <field name="name">sale.form.inherit.survey</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_survey" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-gears" 
                            invisible="cylinder_survey_count == 0"
                            groups="impsa_cylinder_survey.group_cylinder_survey_user">
                        <field name="cylinder_survey_count" widget="statinfo" string="Levantamiento"/>
                    </button>
                </div>
                <xpath expr="//field[@name='partner_id']"
                   position="after">       
                       <field name="partner_contact_ids" invisible="1"/>

                        <field name="partner_contact_id"
                            context="{'no_company_prefix': True}"
                            options="{
                                'no_create': True,
                                'no_open': True,
                                'no_quick_create': True
                            }"/>
                     <field name="survey_id"
                     invisible="True"/>
                     <field name="dropship_option"/>
                     <field name="apu_id" invisible="True" groups="impsa_cylinder_survey.group_apu_user"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_apu_survey"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="apu_survey_count == 0"
                        groups="impsa_cylinder_survey.group_apu_user">
                        <field name="apu_survey_count" widget="statinfo" string="APU"/>
                        </button>

                </xpath>

                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_crm_lead"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-handshake-o"
                            invisible="not opportunity_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Oportunidad</span>
                        </div>
                    </button>
                </xpath>

                <!-- <xpath expr="//header" position="inside">

                    <button name="action_print_proforma_custom"
                        type="object"
                        string="Imprimir"
                        class="btn-primary"/>

                </xpath> -->

                <xpath expr="//button[@name='sale.action_report_saleorder']" position="replace">
                    <button name="action_print_proforma_custom"
                        type="object"
                        string="Imprimir"
                        class="btn-primary"/>
                </xpath>
<!-- 
                <xpath expr="//field[@name='order_line']"
                    position="attributes">
                    <attribute name="readonly">apu_id</attribute>
                </xpath> -->

                <xpath expr="//field[@name='pricelist_id']"
                    position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="before">
                    <field name="product_template_domain" column_invisible="1"/>
                </xpath>

                <!-- 2. Aplicar el dominio al campo producto -->
                <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                    <attribute name="domain">product_template_domain</attribute>
                </xpath>
            </field>
        </record>

        <record id="sale.email_template_edi_sale" model="mail.template">
            <field name="report_template_ids"
                   eval="[(6, 0, [ref('impsa_cylinder_survey.action_report_proforma_custom')])]"/>
        </record>
    </data>
</odoo>