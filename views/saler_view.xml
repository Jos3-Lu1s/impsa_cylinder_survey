<odoo>
    <data>
        <record id="view_sale_order_form_inherit_survey" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.survey</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']"
                   position="after">       
                     <field name="requeriments_work_order"
                     invisible="requeriments_work_order == False"/>
                     <field name="group_requeriments_work_order"
                     invisible="group_requeriments_work_order == False"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_survey"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="cylinder_survey_count == 0">

                        <field name="cylinder_survey_count" widget="statinfo" string="Levantamientos"/>
                        </button>

                </xpath>

                <xpath expr="//header" position="inside">

                    <button name="action_print_proforma_custom"
                        type="object"
                        string="Proforma"
                        class="btn-primary"/>

                </xpath>

            </field>
        </record>
    </data>
</odoo>