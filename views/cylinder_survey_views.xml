<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cylinder_image_kanban_shared" model="ir.ui.view">
        <field name="name">impsa.cylinder.image.kanban.shared</field>
        <field name="model">impsa.cylinder.image</field>
        <field name="arch" type="xml">
            <kanban string="Imágenes del cilindro" default_group_by="cylinder_number">
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="d-flex align-items-center justify-content-center overflow-hidden" style="height: 200px; background-color: #f8f9fa;">
                                <field name="image" widget="image" options="{'size': [256, 256]}" />
                            </div>
                            <div class="mt-2 p-2">
                                <field name="name" class="fw-bolder"/>
                                <div class="mt-1">
                                    <!-- <span class="badge rounded-pill text-bg-secondary"><field name="group_id"/></span> -->
                                    <span class="badge rounded-pill text-bg-secondary">Cilindro <field name="cylinder_number"/></span>
                                    <span class="badge rounded-pill text-bg-primary me-1"><field name="component"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cylinder_image_form_shared" model="ir.ui.view">
        <field name="name">impsa.cylinder.image.form.shared</field>
        <field name="model">impsa.cylinder.image</field>
        <field name="arch" type="xml">
            <form string="Detalle de Imagen">
                <sheet>
                    <group>
                        <group>
                            <field name="cylinder_number" />
                            <field name="component" />
                            <field name="name" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <div class="row mt-3">
                        <div class="col-12 text-center">
                            <field name="image" widget="image" nolabel="1" style="max-width: 100%; background-color: #f8f9fa; border-radius: 8px;" />
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_tree" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.tree</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <list string="Levantamientos" decoration-muted="state == 'cancel'">
                <field name="name" decoration-bf="1" />
                <field name="date" />
                <field name="partner_id" widget="many2one_avatar" />
                <field name="activity_ids" string="Actividades" widget="list_activity" />
                <field name="description" optional="hide" />
                <field name="cylinder_type" optional="show" />
                <field name="state" widget="badge" 
                        decoration-info="state == 'draft'" 
                        decoration-primary="state == 'apu'" 
                        decoration-warning="state == 'quoted'" 
                        decoration-success="state == 'confirmed'" 
                        decoration-danger="state == 'cancel'" 
                        column_invisible="context.get('hide_state', False)" />
            </list>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_form" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.form</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <form string="Levantamiento de Cilindro">
                <header>
                    <button name="action_create_purchase_order" string="Crear Orden de Compra" type="object" class="btn-primary" invisible="state != 'confirmed'"/>

                    <button name="action_to_apu" string="Enviar a APU" type="object" class="oe_highlight" invisible="state != 'draft'" />

                    <button name="action_quoted" string="Confirmar Cotización" type="object" class="oe_highlight" invisible="state != 'apu'" />

                    <button name="action_confirm" string="Confirmar Levantamiento" type="object" class="oe_highlight" invisible="state != 'quoted'" />

                    <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ['draft', 'apu', 'quoted']" confirm="¿Está seguro de que desea cancelar este registro?" />

                    <button name="action_set_draft" string="Volver a Levantamiento" type="object" invisible="state != 'cancel'" />

                    <field name="state" widget="statusbar" statusbar_visible="draft,apu,quoted,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="Referencia" />
                        </h1>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="not purchase_order_ids">
                            <field name="purchase_order_count" widget="statinfo" string="Compras"/>
                        </button>
                        <button name="action_view_lead" type="object" class="oe_stat_button" icon="fa-star" invisible="not lead_id">
                            <field name="lead_count" widget="statinfo" string="Oportunidad"/>
                        </button>
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_ids">
                            <field name="sale_count" widget="statinfo" string="Ventas"/>
                        </button>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 border-end">
                            <group>
                                <field name="partner_id" widget="res_partner_many2one"/>
                                <field name="date" options="{'numeric': true}"/>
                                <label for="cylinder_qty" string="Cilindros"/>

                                <div class="d-flex align-items-center">
                                    <field name="allocated_qty"
                                        nolabel="1"
                                        readonly="1"
                                        class="fw-bold fs-5 me-1 flex-grow-0 w-auto"
                                        decoration-danger="allocated_qty != cylinder_qty"
                                        decoration-success="allocated_qty == cylinder_qty"/>

                                    <span class="mx-1 mb-2 fs-5 text-muted">/</span>

                                    <field name="cylinder_qty"
                                        nolabel="1"
                                        class="flex-grow-0 fs-5 ms-1 w-auto"
                                        style="width: 60px;"/>
                                </div>
                                <field name="is_standardized" widget="boolean_toggle"/>
                                <field name="cylinder_type" widget="selection_badge"/>
                            </group>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row g-2 mb-3 ms-md-2">
                                <div class="col-4">
                                    <div class="card shadow-sm border-0 text-center p-2 h-100" style="background-color: #f8f9fa;">
                                        <div class="small fw-bold text-uppercase" style="color: #6c757d; font-size: 0.65rem;">Tareas</div>
                                        <div class="h4 mb-0 fw-bolder" style="color: #495057;">
                                            <field name="total_tasks" readonly="1" nolabel="1" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-4">
                                    <div class="card shadow-sm border-0 text-center p-2 h-100" style="background-color: #cfe2ff;">
                                        <div class="small fw-bold text-uppercase" style="color: #4b6a9b; font-size: 0.65rem;">Grupos</div>
                                        <div class="h4 mb-0 fw-bolder" style="color: #084298;">
                                            <field name="total_groups" readonly="1" nolabel="1" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="card shadow-sm border-0 text-center p-2 h-100" style="background-color: #fff3cd;">
                                        <div class="small fw-bold text-uppercase" style="color: #856404; font-size: 0.65rem;">Empaques</div>
                                        <div class="h4 mb-0 fw-bolder" style="color: #664d03;">
                                            <field name="total_packings" readonly="1" nolabel="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <group>
                                <field name="cylinder_to" string="Cilindro de" options="{'no_open': True}"/>
                                <field name="cylinder_to_code" invisible="1"/>
                                <field name="num_section" invisible="cylinder_to_code != 'CE-T'"/>
                                <field name="purchase_order_create" invisible="1"/>
                                <field name="description" rows="3" placeholder="Cilindro Hidráulico" />
                            </group>
                        </div>
                    </div>
                    <group string="Resumen Técnico" col="3" invisible="cylinder_to_code == 'CE-OT'">
                        <group string="Camisa" invisible="cylinder_to_code in ('CE-T', 'CE-OT')">
                            <field name="barrel_inner_diameter"/>
                            <field name="barrel_outer_diameter"/>
                            <field name="barrel_length"/>
                        </group>

                        <group string="Vástago" invisible="cylinder_to_code in ('CE-T', 'CE-OT')">
                            <field name="diameter_rod"/>
                            <field name="rod_length" string="Longitud"/>
                        </group>

                        <group string="Vástago 2" invisible="cylinder_to_code != 'CE-DV'">
                            <field name="diameter_rod2"/>
                            <field name="rod_length2" string="Longitud"/>
                        </group>

                        <group string="Émbolo" invisible="cylinder_to_code in ('CE-T', 'CE-OT')">
                            <field name="piston_diameter"/>
                            <field name="piston_length" string="Longitud"/>
                        </group>

                        <group string="Cabeza" invisible="cylinder_to_code in ('CE-T', 'CE-OT')">
                            <field name="head_diameter"/>
                            <field name="head_length" string="Longitud"/>
                        </group>

                        <field name="section_ids" nolabel="1" colspan="3" invisible="cylinder_to_code != 'CE-T'">
                            <list editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="section_type" column_invisible="True"/>
                                
                                <field name="name" readonly="1" force_save="1" decoration-bf="1" width="200px"/>
                                
                                <field name="inner_diameter" 
                                       force_save="1"
                                       readonly="section_type == 'last'" 
                                       decoration-warning="section_type == 'last'"
                                       string="Ø Interior"/>
                                       
                                <field name="outer_diameter" force_save="1" string="Ø Vástago (Ext)" decoration-bf="1"/>
                                
                                <field name="length" string="Longitud" force_save="1"/>
                                
                                <field name="piston_diameter" 
                                       force_save="1"
                                       readonly="section_type == 'main'" 
                                       decoration-warning="section_type == 'main'"/>
                                       
                                <field name="piston_length" 
                                       string="Long. Émbolo"
                                       readonly="section_type == 'main'" 
                                       force_save="1"
                                       decoration-warning="section_type == 'main'"/>
                                
                                <field name="head_diameter" 
                                       readonly="section_type in ('last', 'main')" 
                                       force_save="1"
                                       decoration-warning="section_type in ('last', 'main')"/>
                                       
                                <field name="head_length" 
                                       string="Long. Cabeza"
                                       force_save="1"
                                       readonly="section_type in ('last', 'main')" 
                                       decoration-warning="section_type in ('last', 'main')"/>
                            </list>
                        </field>

                        <group string="Carrera" invisible="cylinder_to_code == 'CE-OT'">
                            <field name="stroke_length" string="Longitud Total"/>
                        </group>
                    

                        <group>
                            
                        </group>
                    </group>
                    <group string="Accesorios" invisible="cylinder_to_code != 'CE-OT'">
                        <field name="accessories"
                            nolabel="1" 
                            colspan="2"
                            style="min-height: 250px;"
                            placeholder="Ej:&#10;- 2 Rótulas de 2 pulgadas&#10;- 1 Válvula de retención..."
                            options="{'collaborative': true, 'resizable': true}"/>
                    </group>

                    <notebook>
                        <page string="Grupos y Operaciones" name="groups">
                            <field name="group_ids" readonly="state not in ('draft', 'apu')">
                                <list string="Grupos de Cilindros">
                                    <field name="name"/>
                                    <field name="quantity" string="Total de cilindros" width="220"/>
                                    <field name="sale_order_id" 
                                           string="Cotización" 
                                           widget="badge" 
                                           decoration-success="True" 
                                           column_invisible="not parent.sale_order_ids"/>
                                    <field name="sale_state" 
                                           string="Estado Cot." 
                                           widget="badge" 
                                           column_invisible="not parent.sale_order_ids"
                                           decoration-warning="sale_state == 'draft'"
                                           decoration-info="sale_state == 'sent'"
                                           decoration-success="sale_state == 'sale'"
                                           decoration-danger="sale_state == 'cancel'"/>
                                    <button name="action_open_sale_order" 
                                            column_invisible="not parent.sale_order_ids"
                                            invisible="not sale_order_id"
                                            type="object"
                                            class="oe_link"
                                            string="Ver Cotización">
                                    </button>
                                </list>

                                <form string="Detalle del Grupo">
                                    <sheet>
                                        <group col="4">
                                            <field name="name" placeholder="Ej. 3 Cilindros Idénticos del frente..."/>
                                            <field name="quantity"/>
                                        </group>
                                        <notebook>
                                            <page string="Operaciones del Grupo">
                                                <field name="operational_record_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="work_to_do"/>
                                                        <field name="obs" optional="show"/>
                                                    </list>
                                                </field>
                                            </page>
                                            
                                            <page string="Fotografías por Cilindro" name="group_images">
                                                <field name="image_ids" mode="kanban" context="{
                                                    'default_group_id': id,
                                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                                }"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Resumen de Operaciones" name="all_operations_summary" invisible="not group_ids">
                            <field name="all_operational_record_ids" readonly="state not in ('draft', 'apu')">
                                <list editable="bottom" default_order="group_id, sequence">
                                    <!-- <field name="sequence" widget="handle"/> -->
                                    <field name="group_id" string="Grupo" options="{'no_create': True, 'no_open': True}" domain="[('survey_id', '=', parent.id)]" decoration-bf="1"/>
                                    <field name="work_to_do"/>
                                    <field name="obs" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Galería Fotográfica Total" name="gallery">
                            <p class="text-muted mt-2 mb-2">
                                <i class="fa fa-info-circle me-1" title="Información"></i>
                                <em>Vista consolidada de todas las fotos de todos los grupos. Para agregar o modificar fotos, ingresa a la pestaña "Grupos y Operaciones".</em>
                            </p>
                            <field name="image_ids" mode="kanban" readonly="1" context="{
                                'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                            }"/>
                        </page>

                        <page string="Requisición de Empaques" name="packing_list">
                            <field name="cylinder_survey_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" optional="show" options="{'no_create': True}" placeholder="Buscar en catálogo..."/>
                                    <field name="description_label" optional="show" />
                                    <field name="code_label" optional="show" />
                                    <field name="dimensions" optional="show" />
                                    <field name="type_piece" widget="radio" options="{'horizontal': True}" optional="show" width="220" />
                                    <field name="unit_quantity" optional="show" />
                                    <field name="unit_total" widget="float" optional="show" />
                                </list>
                            </field>
                            <group string="Proveedores">
                                <field name="date_delivery" string="Fecha de Entrega" />
                            </group>
                        </page>

                        <page string="Notas Internas" name="notes">
                            <field name="internal_notes" placeholder="Escribe tus notas aquí..." nolabel="1" />
                        </page>

                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_search" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.search</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <search string="Buscar Levantamiento">
                <field name="name" />
                <field name="partner_id" />
                <filter string="Fecha" name="date" date="date" />
                <group>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}" />
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>