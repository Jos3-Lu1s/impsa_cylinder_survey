<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cylinder_image_kanban_shared" model="ir.ui.view">
        <field name="name">impsa.cylinder.image.kanban.shared</field>
        <field name="model">impsa.cylinder.image</field>
        <field name="arch" type="xml">
            <kanban string="Imágenes del cilindro">
                <templates>
                    <t t-name="card">
                        <div style="padding: 0; overflow: hidden;">
                            <div class="d-flex align-items-center justify-content-center" style="height: 200px; background-color: #e4e4e4;">
                                <field name="image" widget="image" options="{'size': [256, 256]}" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cylinder_image_form_shared" model="ir.ui.view">
        <field name="name">impsa.cylinder.image.form.shared</field>
        <field name="model">impsa.cylinder.image</field>
        <field name="arch" type="xml">
            <form string="Detalle de Imagen">
                <sheet>
                    <div class="row mb-3">
                        <div class="col-12">
                            <group>
                                <field name="name" placeholder="Ej. Fisura en la rosca..." />
                                <field name="component" />
                            </group>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-center">
                            <field name="image" widget="image" nolabel="1" style="width: 100%; background-color: #e4e4e4;" />
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_tree" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.tree</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <list string="Levantamientos" decoration-muted="state == 'cancel'">
                <field name="name" decoration-bf="1" />
                <field name="date" />
                <field name="partner_id" widget="many2one_avatar" />
                <field name="activity_ids" string="Actividades" widget="list_activity" />
                <field name="description" optional="hide" />
                <field name="cylinder_type" optional="show" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'quoted'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancel'" column_invisible="context.get('hide_state', False)" />
            </list>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_form" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.form</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <form string="Levantamiento de Cilindro">
                <header>
                    <button name="action_create_purchase_order" string="Crear Orden de Compra" type="object" class="btn-primary" invisible="state != 'confirmed'"/>

                    <button name="action_quoted" string="Confirmar Cotización" type="object" class="oe_highlight" invisible="state != 'draft'" />

                    <button name="action_confirm" string="Confirmar Levantamiento" type="object" class="oe_highlight" invisible="state != 'quoted'" />

                    <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ['draft', 'quoted', 'confirmed']" confirm="¿Está seguro de que desea cancelar este registro?" />

                    <button name="action_set_draft" string="Volver a Levantamiento" type="object" invisible="state != 'cancel'" />

                    <field name="state" widget="statusbar" statusbar_visible="draft,quoted,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="Referencia" />
                        </h1>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_order_ids">
                            <field name="purchase_order_count" widget="statinfo" string="Compras"/>
                        </button>
                        <button name="action_view_lead" type="object" class="oe_stat_button" icon="fa-star" invisible="not lead_id">
                            <field name="lead_count" widget="statinfo" string="Oportunidad"/>
                        </button>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 border-end">
                            <group>
                                <field name="partner_id" widget="res_partner_many2one"/>
                                <field name="date" options="{'numeric': true}"/>
                                <label for="cylinder_qty" string="Cilindros"/>

                                <div class="d-flex align-items-center">
                                    <field name="allocated_qty"
                                        nolabel="1"
                                        readonly="1"
                                        class="fw-bold fs-5 me-1 flex-grow-0 w-auto"
                                        decoration-danger="allocated_qty != cylinder_qty"
                                        decoration-success="allocated_qty == cylinder_qty"/>

                                    <span class="mx-1 mb-2 fs-5 text-muted">/</span>

                                    <field name="cylinder_qty"
                                        nolabel="1"
                                        class="flex-grow-0 fs-5 ms-1 w-auto"
                                        style="width: 60px;"/>
                                </div>
                                <field name="is_standardized" widget="boolean_toggle"/>
                                <field name="cylinder_type" widget="selection_badge"/>
                            </group>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row g-2 mb-3 ms-md-2">
                                <div class="col-6">
                                    <div class="card shadow-sm border-0 bg-primary-light text-center p-2">
                                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem;">Total Tareas</div>
                                        <div class="h4 mb-0 text-primary">
                                            <field name="total_tasks" readonly="1" nolabel="1" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card shadow-sm border-0 bg-success-light text-center p-2">
                                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem;">Tiempo Estimado</div>
                                        <div class="h4 mb-0 text-success">
                                            <field name="total_hours" widget="float_time" readonly="1" nolabel="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <group>
                                <field name="cylinder_to" string="Cilindro de" options="{'no_open': True}"/>
                                <field name="cylinder_to_code" invisible="1"/>
                                <field name="description" rows="3" placeholder="Cilindro Hidráulico" />
                            </group>
                        </div>
                    </div>
                    <group string="Resumen Técnico" col="3">

                        <group string="Camisa">
                            <field name="barrel_inner_diameter"/>
                            <field name="barrel_outer_diameter"/>
                            <field name="barrel_length"/>
                        </group>

                        <group string="Vástago">
                            <field name="diameter_rod"/>
                            <field name="rod_length" string="Longitud"/>
                        </group>

                        <group string="Vástago 2">
                            <field name="diameter_rod2"/>
                            <field name="rod_length2" string="Longitud"/>
                        </group>

                        <group string="Émbolo">
                            <field name="piston_diameter"/>
                            <field name="piston_length" string="Longitud"/>
                        </group>

                        <group string="Cabeza">
                            <field name="head_diameter"/>
                            <field name="head_length" string="Longitud"/>
                        </group>

                        <group string="Carrera">
                            <field name="stroke_length" string="Longitud"/>
                        </group>
                        
                        <group string="Accesorios">
                            <field name="rotula_id"/>
                            <field name="accessories" nolabel="1" placeholder="Detalle los accesorios aquí..." colspan="2"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Especificaciones Técnicas" name="specs">

                            <group col="1">

                                <group string="Camisa" col="3">
                                    <group>
                                        <field name="barrel_inner_diameter" string="Diámetro Interior (Ø)" />
                                    </group>
                                    <group>
                                        <field name="barrel_outer_diameter" string="Diámetro Exterior (Ø)" />
                                    </group>
                                    <group>
                                        <field name="barrel_length" string="Longitud de la Camisa" />
                                    </group>
                                </group>
                                <field name="barrel_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'barrel', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />
                                <group string="Vástago">
                                    <group>
                                        <field name="diameter_rod" />
                                    </group>
                                    <group>
                                        <field name="rod_length" />
                                    </group>
                                </group>
                                <field name="rod_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'rod', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />

                                <group string="Émbolo">
                                    <group>
                                        <field name="piston_diameter" />
                                    </group>
                                    <group>
                                        <field name="piston_length" />
                                    </group>
                                </group>
                                <field name="piston_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'piston', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />

                                <group string="Cabeza">
                                    <group>
                                        <field name="head_diameter" />
                                    </group>
                                    <group>
                                        <field name="head_length" />
                                    </group>
                                </group>
                                <field name="head_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'head', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />

                                <group string="Carrera">
                                    <group>
                                        <field name="stroke_length" />
                                    </group>
                                </group>
                                <field name="stroke_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'stroke', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />

                                <group string="Accesorios">
                                    <field name="accessories" nolabel="1" placeholder="Detalle los accesorios aquí..." colspan="2"/>
                                </group>

                                <field name="accessory_image_ids" mode="kanban" nolabel="1" context="{
                                    'default_component': 'accessory', 
                                    'kanban_view_ref': 'impsa_cylinder_survey.view_cylinder_image_kanban_shared', 
                                    'form_view_ref': 'impsa_cylinder_survey.view_cylinder_image_form_shared'
                                }" />

                            </group>

                        </page>
                        <page string="Galería Fotográfica" name="gallery">
                            <field name="image_ids" mode="kanban">
                                <kanban string="Imágenes del Cilindro">
                                    <templates>
                                        <t t-name="card">
                                            <div style="padding: 0; overflow: hidden;">
                                                <div class="d-flex align-items-center justify-content-center" style="height: 200px; background-color: #e4e4e4;">
                                                    <field name="image" widget="image" />
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>

                                <form string="Detalle de Imagen">
                                    <sheet>
                                        <div class="row mb-3">
                                            <div class="col-12">
                                                <group>
                                                    <field name="name" placeholder="Ej. Fisura en la rosca..." />
                                                    <field name="component" />
                                                </group>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-12 text-center">
                                                <field name="image" widget="image" nolabel="1" style="width: 100%; background-color: #e4e4e4;" />
                                            </div>
                                        </div>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Grupos y Operaciones" name="groups">
                            <field name="group_ids">
                                <list string="Grupos de Cilindros">
                                    <field name="name"/>
                                    <field name="operational_record_ids"/>
                                    <field name="quantity" string="Total de cilindros" width="150"/>
                                    <field name="group_total_hours" string="Horas del Grupo" widget="float_time"/>
                                </list>

                                <form string="Detalle del Grupo">
                                    <sheet>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="quantity"/>
                                        </group>
                                        <notebook>
                                            <page string="Operaciones del Grupo">
                                                <field name="operational_record_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="work_to_do"/>
                                                        <field name="obs" optional="show"/>
                                                        <field name="hr" widget="float_time"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Resumen de Operaciones" name="all_operations_summary" invisible="not group_ids">
                            <field name="all_operational_record_ids">
                                <list editable="bottom" default_order="group_id, sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="group_id" string="Grupo" options="{'no_create': True, 'no_open': True}" domain="[('survey_id', '=', parent.id)]" decoration-bf="1"/>
                                    <field name="work_to_do"/>
                                    <field name="obs" optional="show"/>
                                    <field name="hr" widget="float_time"/>
                                </list>
                            </field>

                            <p class="text-muted mt-2 mb-0">
                                <i class="fa fa-lightbulb-o me-1"></i>
                                <em>Puedes editar o agregar operaciones desde aquí. Asegúrate de seleccionar el <b>Grupo</b> correcto al agregar una nueva línea.</em>
                            </p>
                        </page>

                        <page string="Requisición de Empaques" name="packing_list">
                            <field name="cylinder_survey_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" optional="show" options="{'no_create': True}" placeholder="Buscar en catálogo..."/>
                                    <field name="description_label" optional="show" />
                                    <field name="code" optional="hide" />
                                    <field name="code_label" optional="show" />
                                    <field name="dimensions" optional="show" />
                                    <field name="type_piece" widget="radio" options="{'horizontal': True}" optional="show" width="220" />
                                    <field name="material_drop" string="Material" options="{'no_open': True}" optional="show" />
                                    <field name="unit_quantity" optional="show" />
                                    <field name="unit_total" optional="show" />
                                </list>
                            </field>

                            <group string="Proveedores">
                                <field name="date_delivery" string="Fecha de Entrega" />
                            </group>
                        </page>

                        <page string="Notas Internas" name="notes">
                            <field name="internal_notes" placeholder="Escribe tus notas aquí..." nolabel="1" />
                        </page>

                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_impsa_cylinder_survey_search" model="ir.ui.view">
        <field name="name">impsa.cylinder.survey.search</field>
        <field name="model">impsa.cylinder.survey</field>
        <field name="arch" type="xml">
            <search string="Buscar Levantamiento">
                <field name="name" />
                <field name="partner_id" />
                <filter string="Fecha" name="date" date="date" />
                <group>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}" />
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>