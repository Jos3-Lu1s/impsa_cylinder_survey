<odoo>
    <data>
        <record id="view_hr_form_inherit_survey" model="ir.ui.view">
            <field name="name">hr.form.inherit.survey</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']"
                   position="after">       
                     <field name="hourly_cost"/>
                </xpath>


            </field>
        </record>
    </data>
</odoo>