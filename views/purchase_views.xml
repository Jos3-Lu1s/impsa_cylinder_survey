<odoo>
    <data>
        <record id="view_purchase_order_form_inherit_survey" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.survey</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_survey"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="cylinder_survey_count == 0"
                        groups="impsa_cylinder_survey.group_cylinder_survey_user">

                        <field name="cylinder_survey_count" widget="statinfo" string="Levantamientos"/>
                        </button>

                </xpath>
            </field>
        </record>
    </data>
</odoo>