<odoo>
    <data>
        <record id="view_purchase_order_form_inherit_survey" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.survey</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_survey" type="object" class="oe_stat_button" icon="fa-cogs" invisible="cylinder_survey_count == 0" groups="impsa_cylinder_survey.group_cylinder_survey_user">

                        <field name="cylinder_survey_count" widget="statinfo" string="Levantamientos"/>
                    </button>

                </xpath>


                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="statusbar_visible">draft,to approve,purchase</attribute>
                </xpath>


                <xpath expr="//header" position="inside">
                    <field name="is_my_approval_turn" invisible="1"/>
                    <button name="action_approval_approve" type="object" string="Aprobar" class="btn-primary" invisible="not is_my_approval_turn"/>
                    <button name="action_approval_refuse" type="object" string="Rechazar" invisible="not is_my_approval_turn"/>
                </xpath>
              
              
                <xpath expr="//header/button[@name='button_approve']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>


            </field>
        </record>
    </data>
</odoo>