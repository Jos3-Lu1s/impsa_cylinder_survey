<odoo>
    <data>

        <record id="view_crm_stage_form_inherit" model="ir.ui.view">
            <field name="name">crm.stage.form.inherit</field>
            <field name="model">crm.stage</field>
            <field name="inherit_id" ref="crm.crm_stage_form"/>
            <field name="arch" type="xml">
                
                <!-- Insertar después del campo name -->
                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="is_survey"/>
                    <field name="is_apu"/>
                    <field name="is_lose"/>
                    <field name="ganado_state"/>
                </xpath>

                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="stage_type"
                           widget="radio"
                           options="{'horizontal': True}"/>
                </xpath>

                <xpath expr="//field[@name='is_won']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>