<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_impsa_accessory_type" model="ir.actions.act_window">
        <field name="name">Catálogo de Accesorios</field>
        <field name="res_model">impsa.accessory.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_impsa_accessory_type_list" model="ir.ui.view">
        <field name="name">impsa.accessory.type.list</field>
        <field name="model">impsa.accessory.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" decoration-bf="1"/>
                <field name="tech_template" widget="text" placeholder="Ej: Ø Int: __ | Ø Ext: __"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_impsa_accessory_type"
              name="Tipos de Accesorios"
              parent="menu_cylinder_catalogos"
              action="action_impsa_accessory_type"
              sequence="10"/>
</odoo>