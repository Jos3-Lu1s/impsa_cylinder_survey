<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_impsa_accessory_type_search" model="ir.ui.view">
        <field name="name">impsa.accessory.type.search</field>
        <field name="model">impsa.accessory.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Accesorios">
                <field name="name"/>
                <field name="tech_template"/>
                <separator/>
                <filter string="Archivados" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_impsa_accessory_type_list" model="ir.ui.view">
        <field name="name">impsa.accessory.type.list</field>
        <field name="model">impsa.accessory.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Accesorios" editable="bottom" decoration-muted="not active">
                <field name="name" decoration-bf="1" placeholder="Ej. Rótula, Buje..." width="250px"/>

                <field name="tech_template" widget="text" placeholder="Ej: Ø Int: ___&#10;Ø Ext: ___" width="400px"/>

                <field name="active" widget="boolean_toggle" string="Activo" width="80px"/>
            </list>
        </field>
    </record>

    <record id="action_impsa_accessory_type" model="ir.actions.act_window">
        <field name="name">Catálogo de Accesorios</field>
        <field name="res_model">impsa.accessory.type</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_impsa_accessory_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer Tipo de Accesorio
            </p>
            <p>
                Añade accesorios y define sus plantillas técnicas directamente en esta tabla 
                para agilizar las capturas en los levantamientos.
            </p>
        </field>
    </record>
</odoo>