<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cylinder_material" model="ir.ui.view">
        <field name="name">cylinder.material</field>
        <field name="model">impsa.cylinder.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cylinder_material_form" model="ir.ui.view">
        <field name="name">cylinder.material.form</field>
        <field name="model">impsa.cylinder.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>