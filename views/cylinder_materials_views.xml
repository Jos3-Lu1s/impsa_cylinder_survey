<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_impsa_cylinder_material_search" model="ir.ui.view">
        <field name="name">impsa.cylinder.material.search</field>
        <field name="model">impsa.cylinder.material</field>
        <field name="arch" type="xml">
            <search string="Buscar Materiales">
                <field name="name"/>
                <separator/>
                <filter string="Archivados" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_impsa_cylinder_material_list" model="ir.ui.view">
        <field name="name">impsa.cylinder.material.list</field>
        <field name="model">impsa.cylinder.material</field>
        <field name="arch" type="xml">
            <list string="Catálogo de Materiales" editable="bottom" decoration-muted="not active">
                <field name="name" decoration-bf="1" placeholder="Ej. Acero 1045, Bronce SAE 660, Nylamid..." width="400px"/>
                <field name="active" widget="boolean_toggle" width="80px"/>
            </list>
        </field>
    </record>

    <record id="action_cylinder_material" model="ir.actions.act_window">
        <field name="name">Catálogo de Materiales</field>
        <field name="res_model">impsa.cylinder.material</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_impsa_cylinder_material_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añade el primer material a tu catálogo
            </p>
            <p>
                Gestiona los diferentes materiales utilizados en la reparación y fabricación 
                de los componentes del cilindro directamente desde esta tabla.
            </p>
        </field>
    </record>

</odoo>