<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- PRIVILEGIO (reemplaza categoría) -->
        <record id="privilege_cylinder_survey" model="res.groups.privilege">
            <field name="name">Taller de Cilindros</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_apu" model="res.groups.privilege">
            <field name="name">Análisis de Precios Unitarios (APU)</field>
            <field name="sequence">20</field>
        </record>

        <!-- GRUPOS -->
        <record id="group_cylinder_survey_user" model="res.groups">
            <field name="name">Usuario de Taller de Cilindros</field>
            <field name="privilege_id" ref="impsa_cylinder_survey.privilege_cylinder_survey"/>

            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                El usuario tendrá acceso al módulo de Taller de Cilindros para registrar levantamientos.
            </field>
        </record>

        <record id="group_cylinder_survey_manager" model="res.groups">
            <field name="name">Administrador de Taller de Cilindros</field>
            <field name="privilege_id" ref="impsa_cylinder_survey.privilege_cylinder_survey"/>
            <field name="implied_ids" eval="[(4, ref('impsa_cylinder_survey.group_cylinder_survey_user'))]"/>
            <field name="comment">
                Acceso total a la configuración del taller, materiales y tipos de accesorios.
            </field>
        </record>

        <record id="group_apu_user" model="res.groups">
            <field name="name">Usuario de APU</field>
            <field name="privilege_id" ref="impsa_cylinder_survey.privilege_apu"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Acceso básico para crear y consultar Análisis de Precios Unitarios.
            </field>
        </record>

        <record id="group_apu_manager" model="res.groups">
            <field name="name">Administrador de APU</field>
            <field name="privilege_id" ref="impsa_cylinder_survey.privilege_apu"/>
            <field name="implied_ids" eval="[(4, ref('impsa_cylinder_survey.group_apu_user'))]"/>
            <field name="comment">
                Acceso total a la configuración de APUs, acciones y márgenes de utilidad.
            </field>
        </record>

        <!-- REGLAS DE SEGURIDAD -->
        <record id="rule_crm_lead_authorized_users" model="ir.rule">
            <field name="name">CRM Lead: Restricción por Usuarios Autorizados en Etapa</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', ('stage_id.authorized_user_ids', '=', False), ('stage_id.authorized_user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>