<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="impsa_cylinder_survey.DynamicQuantitySelect">
        <t t-if="props.readonly">
            <span class="text-truncate" 
                  t-esc="props.record.data[props.name] ? 'Cilindro ' + props.record.data[props.name] : ''"/>
        </t>
        
        <t t-else="">
            <select class="o_input" t-on-change="onChange">
                <option value="0" t-if="!props.record.data[props.name]"></option>
                <t t-if="options.length === 0">
                    <option value="0" selected="1" disabled="1" class="text-muted">
                        No se estableció la cantidad de cilindros
                    </option>
                </t>
                <t t-else="">
                    <t t-foreach="options" t-as="opt" t-key="opt.value">
                        <option t-att-value="opt.value" 
                                t-att-selected="opt.value === props.record.data[props.name]">
                            <t t-esc="opt.label"/>
                        </option>
                    </t>
                </t>
            </select>
        </t>
    </t>
</templates>