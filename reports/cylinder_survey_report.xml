<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cylinder_survey_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <td rowspan="2" width="160">
                                    <img width="150" t-if="o.env.company.logo" t-att-src="image_data_uri(o.env.company.logo)" class="img-fluid" alt="Logo"/>
                                </td>
                                <td width="120" class="ps-3">
                                    <h5 class="m-0 fw-bold">Proceso</h5>
                                </td>
                                <td>
                                    <h5 class="m-0 text-muted">Control operacional</h5>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" class="ps-3">
                                    <h5 class="m-0 fw-bold">Formato para levantamiento de cilindros</h5>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm mt-3 lh-sm">
                        <tbody>
                            <tr>
                                <td>
                                    <span class="fw-bold">CLIENTE:</span>
                                    <span t-field="o.partner_id" class="ms-2"/>
                                </td>
                                <td>
                                    <span class="fw-bold">Ø CAMISA:</span>
                                    <span t-field="o.diameter_sleeve" class="ms-2"/>
                                </td>
                                <td colspan="2">
                                    <span class="fw-bold">FECHA:</span>
                                    <span t-field="o.date" class="ms-2"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="fw-bold">DESCRIPCIÓN:</span>
                                    <span t-field="o.description" class="ms-2"/>
                                </td>
                                <td>
                                    <span class="fw-bold">Ø VÁSTAGO:</span>
                                    <span t-field="o.diameter_rod" class="ms-2"/>
                                </td>
                                <td colspan="2">
                                    <span class="fw-bold">O. TRABAJO:</span>
                                    <span t-field="o.work_order" class="ms-2"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="fw-bold">CILINDRO DE:</span>
                                    <span t-field="o.cylinder_type" class="ms-2"/>
                                </td>
                                <td>
                                    <span class="fw-bold">CARRERA:</span>
                                    <span t-field="o.stroke" class="ms-2"/>
                                </td>
                                <td>
                                    <span class="fw-bold">No. SERIE:</span>
                                    <span t-field="o.serial_number" class="ms-2"/>
                                </td>
                                <td>
                                    <span class="fw-bold">No. PARTE:</span>
                                    <span t-field="o.part_number" class="ms-2"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row">
                        <div class="col-5">
                            <table class="table table-sm">
                                <tr>
                                    <th style="border:1px solid black;">HRS</th>
                                    <th style="border:1px solid black;">TRABAJOS A REALIZAR</th>
                                    <th style="border:1px solid black;">OBS</th>
                                </tr>
                                <t t-foreach="o.operational_record_ids" t-as="line">
                                    <tr>
                                        <td style="border:1px solid black; text-align: center;">
                                            <span t-esc="line.hr" t-options='{"widget": "float_time"}'/>
                                        </td>
                                        <td style="border:1px solid black; padding-left: 4px;">
                                            <span t-esc="line.work_to_do"/>
                                        </td>
                                        <td style="border:1px solid black; padding-left: 4px;">
                                            <span t-esc="line.obs"/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-set="total_lines" t-value="len(o.operational_record_ids)"/>
                                <t t-set="empty_lines" t-value="18 - total_lines"/>

                                <t t-if="empty_lines > 0">
                                    <t t-foreach="range(empty_lines)" t-as="i">
                                        <tr>
                                            <td style="border:1px solid black;">&#160;</td>
                                            <td style="border:1px solid black;">&#160;</td>
                                            <td style="border:1px solid black;">&#160;</td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </div>

                        <div class="col-7 border">
                            <img src="/impsa_cylinder_survey/static/src/img/esquema_base.png" class="img-fluid"/>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-2">
                            <span class="text-muted small">Código:  F-05-01</span>
                        </div>
                        <div class="col-5">
                            <span class="text-muted small">Nombre: F-05-01-Formato para levantamiento de cilindros</span>
                        </div>
                        <div class="col-4">
                            <span class="text-muted small">Fecha de revisión: 31 de marzo 2023</span>
                        </div>
                        <div class="col-1">
                            <span class="text-muted small">Versión: 01 </span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
