    <record id="action_report_proforma_custom" model="ir.actions.report">
        <field name="name">Cotización</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">impsa_cylinder_survey.report_proforma_custom</field>
        <field name="report_file">impsa_cylinder_survey.report_proforma_custom</field>

        <!-- Para que aparezca en imprimir -->
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % (object.name)</field>
    </record>

    <!-- Formato de papel del formato de corte: márgenes pequeños para que el contenido
         empiece arriba de la hoja (el A4 de la compañía deja 52 mm libres arriba). -->
    <record id="paperformat_cut_order" model="report.paperformat">
        <field name="name">Formato de corte IMPSA</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!-- Formato de corte: PDF directo desde la orden de venta (aparece en Imprimir) -->
    <record id="action_report_cut_order_sale" model="ir.actions.report">
        <field name="name">Formato corte PDF</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">impsa_cylinder_survey.report_cut_order_sale</field>
        <field name="report_file">impsa_cylinder_survey.report_cut_order_sale</field>
        <field name="paperformat_id" ref="paperformat_cut_order"/>
        <field name="print_report_name">'Formato corte - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>